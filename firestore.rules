rules_version = '2';

// Estadísticas anónimas de LiteDash (app/Stats.kt): cada pantalla escribe solo su
// documento, con estos campos y la hora del servidor. Nadie puede leer desde la app.
// Reportes (app/Reports.kt): solo crear uno nuevo al tocar Enviar; nunca editar ni leer.
service cloud.firestore {
  match /databases/{database}/documents {
    match /screens/{id} {
      allow create, update: if id.matches('^[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['version', 'channel', 'android', 'language', 'screen', 'since', 'seen'])
        && request.resource.data.version is int && request.resource.data.version < 1000000000
        && request.resource.data.channel in ['play', 'github']
        && request.resource.data.android is int && request.resource.data.android < 1000
        && request.resource.data.language is string && request.resource.data.language.size() <= 8
        && request.resource.data.screen is string && request.resource.data.screen.size() <= 16
        && request.resource.data.since is string && request.resource.data.since.size() == 10
        && request.resource.data.seen == request.time;
    }
    match /reports/{id} {
      allow create: if id.matches('^[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['version', 'channel', 'android', 'debug', 'module', 'detail', 'problem', 'note', 'info', 'sent'])
        && request.resource.data.version is int && request.resource.data.version < 1000000000
        && request.resource.data.channel in ['play', 'github']
        && request.resource.data.android is int && request.resource.data.android < 1000
        && request.resource.data.debug is bool
        && request.resource.data.module is string && request.resource.data.module.size() <= 24
        && request.resource.data.detail is string && request.resource.data.detail.size() <= 24
        && request.resource.data.problem is string && request.resource.data.problem.size() <= 24
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.info is string && request.resource.data.info.size() <= 20000
        && request.resource.data.sent == request.time;
    }
    // Códigos de LiteDash Pro en prueba (app/ProAccess): el id es el SHA-256 del código, así que
    // solo quien lo tiene puede leerlo (listar no). Una pantalla se liga una sola vez: escribe su id
    // si el código está activo y libre. Crear, desactivar o liberar: solo el dueño (consola/backoffice).
    match /pro_codes/{id} {
      allow get: if id.matches('^[0-9a-f]{64}$');
      allow update: if resource.data.active == true
        && !('screen' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['screen', 'bound'])
        && request.resource.data.screen is string && request.resource.data.screen.matches('^[0-9a-f]{32}$')
        && request.resource.data.bound == request.time;
    }
    // Solo para la 1.4.44 y la 1.4.45, que usaban nombres en español.
    match /pantallas/{id} {
      allow create, update: if id.matches('^[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['version', 'canal', 'android', 'idioma', 'pantalla', 'alta', 'visto'])
        && request.resource.data.version is int && request.resource.data.version < 1000000000
        && request.resource.data.canal in ['play', 'github']
        && request.resource.data.android is int && request.resource.data.android < 1000
        && request.resource.data.idioma is string && request.resource.data.idioma.size() <= 8
        && request.resource.data.pantalla is string && request.resource.data.pantalla.size() <= 16
        && request.resource.data.alta is string && request.resource.data.alta.size() == 10
        && request.resource.data.visto == request.time;
    }
    // Cuentas de LiteDash Connect: cada quien escribe solo la suya, nadie lee desde las apps.
    // Al eliminar la cuenta el documento se reemplaza por {provider, since, deleted} (sin nombre)
    // y ya no se puede tocar: la sesión de Auth se borra justo después.
    match /accounts/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid
        && !(resource != null && 'deleted' in resource.data)
        && request.resource.data.provider in ['google', 'password']
        && request.resource.data.since is string && request.resource.data.since.size() == 10
        && ((request.resource.data.keys().hasOnly(['name', 'provider', 'since', 'app', 'language', 'seen'])
              && request.resource.data.name is string && request.resource.data.name.size() <= 100
              && request.resource.data.app is string && request.resource.data.app.size() <= 16
              && request.resource.data.language is string && request.resource.data.language.size() <= 8
              && request.resource.data.seen == request.time)
          || (request.resource.data.keys().hasOnly(['provider', 'since', 'deleted'])
              && request.resource.data.deleted == request.time));
      // La pantalla vinculada a la cuenta (id de 16 hex del protocolo Link): modelo, versión y auto del catálogo.
      match /screens/{id} {
        allow create, update: if request.auth != null && request.auth.uid == uid
          && id.matches('^[0-9a-f]{16}$')
          && request.resource.data.keys().hasOnly(['model', 'launcher', 'car', 'since', 'seen'])
          && request.resource.data.model is string && request.resource.data.model.size() <= 48
          && request.resource.data.launcher is string && request.resource.data.launcher.size() <= 16
          && request.resource.data.car is string && request.resource.data.car.size() <= 64
          && request.resource.data.since is string && request.resource.data.since.size() == 10
          && request.resource.data.seen == request.time;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
